public class Adam {
    private String name;
    private int age;

    public Adam(String name, int age) {
        this.name = name;
        this.age = age;
    }

    public String getName() {
        return name;
    }

    public int getAge() {
        return age;
    }
}
public static void main(String[] args) {
    Adam adam = new Adam("Adam", 30);
    System.out.println("Name: " + adam.getName());
    System.out.println("Age: " + adam.getAge());
}
